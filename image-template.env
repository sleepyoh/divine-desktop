# Image build settings (read by the Justfile)

# Published as ghcr.io/<owner>/sleepy-kde (lowercased by the workflow)
IMAGE_NAME=Sleepy-Kde

REPO_ORGANIZATION="${GITHUB_REPOSITORY_OWNER}"

IMAGE_DESC="Fedora Kinoite 45, customised"
IMAGE_KEYWORDS="bootc,oci,linux"
IMAGE_LOGO_URL="https://avatars.githubusercontent.com/u/120078124?s=200&v=4"
DEFAULT_TAG="latest"

# Not used for the image build, but the Justfile requires it to be set
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
